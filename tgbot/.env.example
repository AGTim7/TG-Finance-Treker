BOT_TOKEN=your_telegram_bot_token
DATABASE_URL=postgresql://user:password@localhost:5432/finance_db?schema=public
NODE_ENV=development
# all runs API and bot together; api/bot allow separate production processes.
PROCESS_ROLE=all
# polling is convenient locally; webhook is required for serverless production.
TELEGRAM_UPDATE_MODE=polling
# Required only when TELEGRAM_UPDATE_MODE=webhook. Use 1-256 characters: A-Z, a-z, 0-9, _ or -.
TELEGRAM_WEBHOOK_SECRET=
# Used by the one-time telegram:setup-webhook command.
TELEGRAM_WEBHOOK_URL=https://your-backend-domain.example/api/telegram/webhook
TELEGRAM_MINI_APP_URL=https://your-mini-app-domain.example
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-mini-app-domain.example
API_PORT=3000
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

TRUST_PROXY=false
